# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# 数据库配置（MySQL）
DATABASE_URL=mysql://root:password@localhost:3306/football
# MySQL 连接池最大连接数（推荐值：10-50，根据服务器性能调整）
DATABASE_MAX_CONNECTIONS=10

# Redis配置（方式1：使用完整URL）
REDIS_URL=redis://localhost:6379

# Redis配置（方式2：使用独立配置，如果设置了REDIS_URL则忽略）
REDIS_HOST=localhost
REDIS_PORT=6379
# Redis密码（可选，如果没有密码则不设置）
# REDIS_PASSWORD=your_password
REDIS_DATABASE=0
# Redis 连接池大小
REDIS_POOL_SIZE=10

# 日志级别
LOG_LEVEL=info
RUST_LOG=info

# 运行模式 (development, production)
RUN_MODE=development

